        basePosition = LocalPlayer.Character.HumanoidRootPart.Position
    end
end

--- Define a velocidade de caminhada do jogador local.
--- @param speed number A nova velocidade de caminhada.
local function setPlayerWalkSpeed(speed: number)
    currentWalkSpeed = speed
    if LocalPlayer and LocalPlayer.Character then
        local humanoid: Humanoid? = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = speed
        end
    end
end

--- Habilita/Desabilita o modo de voo.
--- @param enable boolean True para habilitar, false para desabilitar.
local function setFlyMode(enable: boolean)
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end

    if enable then
        humanoid.PlatformStand = true -- Impede o personagem de cair
        humanoid.WalkSpeed = 0 -- Desabilita movimento normal
        humanoid.JumpPower = 0
        -- Um BodyVelocity ou VectorForce seria mais robusto, mas CFrame é comum em exploits
    else
        humanoid.PlatformStand = false
        humanoid.WalkSpeed = currentWalkSpeed -- Retorna à velocidade definida pelo usuário
        humanoid.JumpPower = 50 -- Valor padrão
    end
end

--- Voa para uma posição com velocidade e opcionalmente com zig-zag.
--- @param targetPosition Vector3 A posição de destino.
--- @param speed number A velocidade de voo.
--- @param zigZag boolean Se deve usar movimento zig-zag.
local function flyTo(targetPosition: Vector3, speed: number, zigZag: boolean)
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    setFlyMode(true) -- Habilita o modo de voo

    local distance = (hrp.Position - targetPosition).magnitude
    local duration = distance / speed
    
    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out,
        0,
        false,
        0
    )

    local currentPos = hrp.CFrame.Position
    local path = {}
    local numSegments = math.max(1, math.ceil(distance / 50)) -- Pelo menos 1 segmento, 1 segmento a cada 50 studs

    for i = 0, numSegments do
        local alpha = i / numSegments
        local interpolatedPos = currentPos:Lerp(targetPosition, alpha)

        if zigZag and i > 0 and i < numSegments then
            -- Adiciona um pequeno offset aleatório para o zig-zag
            local randomOffset = Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5))
            table.insert(path, interpolatedPos + randomOffset)
        else
            table.insert(path, interpolatedPos)
        end
    end

    for i, segmentPos in ipairs(path) do
        if not autoStealEggEnabled and not autoEventEnabled then break end -- Permite parar o voo se a função for desativada

        local segmentDuration = duration / #path
        local goalCFrame = CFrame.new(segmentPos)

        local tween = TweenService:Create(hrp, TweenInfo.new(segmentDuration), {CFrame = goalCFrame})
        tween:Play()
        tween.Completed:Wait()
    end
    
    setFlyMode(false) -- Desabilita o modo de voo após o voo
end

--- Encontra um ovo no Workspace com base na raridade e bioma selecionados.
--- @return Model? O modelo do ovo encontrado, ou nil.
--- @return string? A raridade do ovo encontrado.
local function findEgg(): (Model?, string?)
    local eggFound: Model? = nil
    local eggRarity: string? = nil
    local highestRarityIndex = #EGG_RARITIES + 1 -- Começa com um índice que é "menos raro" que Epic

    -- Itera sobre todos os ovos no Workspace (assumindo que ovos estão em Workspace ou em pastas específicas)
    for _, child in ipairs(Workspace:GetDescendants()) do
        if child:IsA("Model") and child.Name:match("Egg") then -- Procurar por modelos que contenham "Egg" no nome
            local rarityTag = child:GetAttribute("Rarity") or child:FindFirstChild("Rarity") and child.Rarity.Value or child.Name:match("(%a+) Egg") or "Epic" -- Tenta obter raridade de atributo, ValueObject, ou nome

            -- Verifica se a raridade do ovo corresponde à selecionada OU se é mais rara
            local currentEggRarityIndex = table.find(EGG_RARITIES, rarityTag) or (#EGG_RARITIES + 1)
            local selectedRarityIndex = table.find(EGG_RARITIES, selectedEggRarity) or (#EGG_RARITIES + 1)

            -- Prioriza ovos mais raros que o selecionado, e depois o selecionado
            if currentEggRarityIndex <= selectedRarityIndex then
                -- Verifica se o bioma corresponde (assumindo que o bioma pode estar no nome do ovo ou em uma pasta pai)
                local biomeMatch = false
                if string.find(selectedEggBiome, "Biome Eggs") then -- Se é um bioma específico
                    if child.Parent and child.Parent.Name == selectedEggBiome:gsub(" Eggs", "") then -- Ex: Forest Biome Eggs -> Forest Biome
                        biomeMatch = true
                    elseif child.Name:match(selectedEggBiome:gsub(" Eggs", "")) then -- Ex: Forest Egg
                        biomeMatch = true
                    end
                else -- Se for um tipo de ovo geral como Monster Eggs ou Void Eggs
                    if child.Name:match(selectedEggBiome:gsub(" Eggs", "")) then
                        biomeMatch = true
                    end
                end

                if biomeMatch then
                    -- Se for um ovo mais raro que o já encontrado ou se for o primeiro ovo válido
                    if currentEggRarityIndex < highestRarityIndex then
                        highestRarityIndex = currentEggRarityIndex
                        eggFound = child
                        eggRarity = rarityTag
                    elseif currentEggRarityIndex == highestRarityIndex and eggFound == nil then
                        eggFound = child
                        eggRarity = rarityTag
                    end
                end
            end
        end
    end
    return eggFound, eggRarity
end

--- Coleta um ovo.
--- @param eggModel Model O modelo do ovo a ser coletado.
local function collectEgg(eggModel: Model)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Simula a coleta movendo o HRP para o ovo.
    -- Em alguns jogos, isso pode acionar um ClickDetector ou um RemoteEvent.
    -- Aqui, assumimos que tocar é suficiente.
    local originalCFrame = hrp.CFrame
    
    local collectDuration = 1 / currentEggStealSpeed -- Duração baseada na velocidade de roubo
    collectDuration = math.max(0.1, collectDuration) -- Mínimo de 0.1s para evitar spam excessivo

    local tween = TweenService:Create(hrp, TweenInfo.new(collectDuration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(eggModel.Position)})
    tween:Play()
    tween.Completed:Wait()

    -- Espera um pouco para garantir que a coleta seja registrada pelo servidor
    task.wait(0.1) 
    
    -- Retorna à posição original imediatamente após a coleta, para não ficar preso
    -- hrp.CFrame = originalCFrame -- Não necessário se flyToBase() for chamado logo em seguida
end

--- Lógica principal do Auto Steal Egg.
local function autoStealEggLoop()
    while autoStealEggEnabled do
        local egg, rarity = findEgg()
        if egg then
            print("พบไข่: " .. egg.Name .. " (ระดับความหายาก: " .. rarity .. ")")
            flyTo(egg.Position, currentFlySpeed, true) -- Voa com zig-zag
            collectEgg(egg)
            print("ขโมยไข่แล้ว! กลับฐาน...")
            flyTo(basePosition, currentFlySpeed, false) -- Retorna à base sem zig-zag
        else
            print("ยังไม่เกิดนะคนดี")
        end
        task.wait(currentEggStealSpeed) -- Espera antes de procurar o próximo ovo
    end
    setFlyMode(false) -- Garante que o modo de voo seja desabilitado ao parar
end

