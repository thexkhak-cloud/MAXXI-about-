--- Lógica de ataque ao Abyssal Overlord.
local function attackAbyssalOverlord()
    local bossModel = Workspace:FindFirstChild("AbyssalOverlord") -- Assumir nome do modelo do boss
    if not bossModel then
        warn("ไม่พบ Abyssal Overlord!")
        return
    end

    local bossHumanoid = bossModel:FindFirstChildOfClass("Humanoid")
    if not bossHumanoid or bossHumanoid.Health <= 0 then
        warn("Abyssal Overlord ไม่ได้ใช้งานอยู่!")
        return
    end

    print("กำลังเข้าโจมตี Abyssal Overlord...")
    -- Voa para uma posição de ataque segura
    flyTo(bossModel.Position + Vector3.new(0, 10, 20), currentFlySpeed, false)

    while autoEventEnabled and bossHumanoid.Health > 0 do
        local bossHand = bossModel:FindFirstChild("Hand") -- Assumir que o boss tem uma "Hand"
        local handDownThreshold = bossModel.Position.Y - 20 -- Posição Y para considerar a mão "abaixada"

        if bossHand and bossHand.Position.Y < handDownThreshold then
            -- Mão abaixada, atacar!
            -- Simular ataque movendo-se para o boss ou chamando um RemoteEvent
            flyTo(bossModel.Position + Vector3.new(math.random(-5,5), 5, math.random(-5,5)), currentFlySpeed, false)
            task.wait(0.5) -- Pequeno delay para simular ataque
        else
            -- Mão não abaixada, esperar e talvez se esquivar
            flyTo(bossModel.Position + Vector3.new(math.random(-30,30), 10, math.random(-30,30)), currentFlySpeed, false)
            task.wait(0.5)
        end
        task.wait(0.1) -- Pequeno delay entre verificações
    end
    print("Abyssal Overlord ถูกกำจัดแล้ว หรือกิจกรรมถูกปิดใช้งาน")
    setFlyMode(false)
end

--- Lógica principal do Auto Event.
local function autoEventLoop()
    while autoEventEnabled do
        local boss = Workspace:FindFirstChild("AbyssalOverlord")
        if not boss then
            print("รอ Abyssal Overlord เกิด...")
            -- Tentar teletransportar para a dimensão do evento se o boss não estiver no mapa principal
            teleportToAbyssalOverlordDimension()
            task.wait(10) -- Espera para o teleporte e o boss carregar
        else
            attackAbyssalOverlord()
        end
        task.wait(5) -- Espera antes de reavaliar
    end
    setFlyMode(false)
end

